# Versions and resources of the test stand. docker compose reads this file itself (build args of the
# image, environment of the containers), scripts/fetch-dists.sh — for the names of the distributions.
# Environment variables win over the file: YARN_NM_MEMORY_MB=4096 docker/run.sh cluster up
# The same as the target stack of the connector: Spark 3.5.8 / Scala 2.12, Hadoop 3.3.6, Cloudberry 2.1
HADOOP_VERSION=3.3.6
SPARK_VERSION=3.5.8
POSTGRES_JDBC_VERSION=42.7.4
CLOUDBERRY_VERSION=2.1.0-incubating
# primary segments of the single-node cluster (STAND_RESOURCES=large: 8); a change re-initializes Cloudberry
CLOUDBERRY_SEGMENTS=4
# the build of the connector (docker/run.sh jar)
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-11
# YARN NodeManager: memory and vcores for containers, the largest container (MB)
YARN_NM_MEMORY_MB=6144
YARN_NM_VCORES=8
YARN_CONTAINER_MAX_MB=4096
